# Backend
APP_ID=coinin
APP_SECRET=

# Database
DATABASE_URL=

# Admin Role
OWNER_UNION_ID=

# Payment Gateway (Tripay)
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_PAYMENT_METHOD=QRIS2
PAYMENT_API_URL=https://tripay.co.id/api

# Top-up Provider (Digiflazz)
TOPUP_API_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_TESTING=false
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_WEBHOOK_URL=
DIGIFLAZZ_ZONE_SEPARATOR=

# Optional generic aliases still supported:
# TOPUP_API_USERNAME can be used as DIGIFLAZZ_USERNAME
# TOPUP_API_SECRET can be used as DIGIFLAZZ_API_KEY
# TOPUP_WEBHOOK_SECRET can be used as DIGIFLAZZ_WEBHOOK_SECRET

# Public app URL used for payment return/callback URLs and sitemap
VITE_APP_URL=http://localhost:3000

# Background jobs for expiring old orders and syncing processing top-ups.
# Set false on serverless deployments and run these jobs from an external cron instead.
AUTO_SYNC_JOBS=true
