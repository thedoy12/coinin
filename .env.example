# Backend
APP_ID=coinin
APP_SECRET=

# Database
DATABASE_URL=

# Admin Role
OWNER_UNION_ID=

# Payment Gateway (Tripay)
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_PAYMENT_METHOD=QRIS2
PAYMENT_API_URL=https://tripay.co.id/api

# Top-up Provider (HataMarket)
TOPUP_API_URL=https://hatamarket.com/api
HATAMARKET_API_ID=
HATAMARKET_API_KEY=

# Legacy aliases still supported:
# TOPUP_API_KEY can be used as HATAMARKET_API_ID
# TOPUP_API_SECRET can be used as HATAMARKET_API_KEY

# Public app URL used for payment return/callback URLs and sitemap
VITE_APP_URL=http://localhost:3000

# Background jobs for expiring old orders and syncing processing top-ups.
# Set false on serverless deployments and run these jobs from an external cron instead.
AUTO_SYNC_JOBS=true
