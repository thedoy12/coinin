# Backend
APP_ID=coinin
APP_SECRET=

# Database
DATABASE_URL=

# Admin Role
OWNER_UNION_ID=

# Payment Provider
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_METHOD=QRIS
PAYMENT_API_URL=

# Top-up Provider
TOPUP_API_URL=
TOPUP_API_USERNAME=
TOPUP_API_SECRET=
TOPUP_TESTING=false
TOPUP_WEBHOOK_SECRET=
TOPUP_WEBHOOK_URL=
TOPUP_ZONE_SEPARATOR=

# Public app URL used for payment return/callback URLs and sitemap
VITE_APP_URL=http://localhost:3000

# Background jobs for expiring old orders and syncing processing top-ups.
# Set false on serverless deployments and run these jobs from an external cron instead.
AUTO_SYNC_JOBS=true
